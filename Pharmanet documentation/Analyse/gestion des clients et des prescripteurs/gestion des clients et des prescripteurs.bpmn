  <bpmn:collaboration id="Collaboration_00uxsih">
    <bpmn:participant id="Participant_0z6c4zs" name="Enregistrement ou mise à jour d’un client et d&#39;un prescripteur" processRef="Process_08rskzp" />
    <bpmn:textAnnotation id="TextAnnotation_183dby7">
      <bpmn:text>Modification de certains champs (ex : nouveau téléphone, nouvelle réduction, adresse mise à jour)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_08qe18r">
      <bpmn:text>nom, prénom, date de naissance (facultatif), sexe, téléphone, adresse, e-mail (optionnel), info complémentaire</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1itqlah">
      <bpmn:text>Affichage de confirmation</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1ltq6a7">
      <bpmn:text>Saisie des champs : nom, prénom, spécialité, structure (ex : Hôpital Laquintinie), téléphone, e-mail</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1j2d12m">
      <bpmn:text>Edition d’informations comme la structure ou le téléphone</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_07kxy8i" associationDirection="None" sourceRef="Activity_1esyepj" targetRef="TextAnnotation_183dby7" />
    <bpmn:association id="Association_1d4lv5f" associationDirection="None" sourceRef="Activity_127o2yi" targetRef="TextAnnotation_08qe18r" />
